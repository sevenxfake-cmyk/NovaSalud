{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/inventario", "destination": "/index.html" },
    { "source": "/alertas", "destination": "/index.html" },
    { "source": "/ventas", "destination": "/index.html" },
    { "source": "/historial", "destination": "/index.html" }
  ]
}
